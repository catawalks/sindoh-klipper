#!/bin/sh
# 3DWOX 1X: start Klipper at boot (docs/1x_install_plan.md). Installed by
# the 1X installer as /etc/init.d/S99klipper; the only file of ours on the
# stock system. Removing it (or a Sindoh firmware update, which replaces
# the root) gives a stock printer again. The work is done in the
# background by x1_hook.sh (installed as boot.sh: SSH, then x1_boot.sh), so the stock boot is not held up.
BOOT=/userdata/klipper/boot.sh
case "$1" in
start)
    # "early" must finish before the console logs in (it may cover
    # /run.sh for a cold start); the rest runs in the background
    [ -f $BOOT ] && { sh $BOOT early > /dev/null 2>&1; (sh $BOOT > /dev/null 2>&1 &); }
    ;;
stop) ;;
*)  echo "usage: $0 start|stop" ;;
esac
exit 0
